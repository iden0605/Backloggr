{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backloggr",
  "version": "0.7.0",
  "identifier": "com.idenc.gamebacklog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "backloggr",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/clips/*"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MEIyOUNEMEMyQzUyNUIKUldSYlVpd016U2tMMUxMSHRFc0RwOG9SRC91a1gwZzFqN1h4WGlVeGg1YUQ5RCtTQkJBcnNtQWoK",
      "endpoints": [
        "https://github.com/iden0605/Backloggr/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "29896101-9238-5686-9555-0cbe87e84bf4"
      }
    },
    "resources": [
      "resources/tabbed_out.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
